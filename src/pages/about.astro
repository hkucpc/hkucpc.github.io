---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import JoinCta from '../components/JoinCta.astro';

const facts = [
  { label: 'Founded', value: '1991' },
  { label: 'Based in', value: 'Department of Computer Science / Department of AI & Data Science' },
  { label: 'ICPC World Finals', value: '10 appearances' },
  { label: 'ICPC regional medals', value: '67 and counting' },
];

const pillars = [
  {
    no: '01',
    title: 'Train',
    text: 'Weekly training during term, usually on Virtual Judge: theory, problem solving and contest simulations, plus a group upsolve. Problem sets are curated, not scraped. Sessions are free and open to all HKU students.',
  },
  {
    no: '02',
    title: 'Select',
    text: 'Each season we run a 2.5-hour individual selection contest. It places contestants into squads, but it is not an entrance exam. Everyone can keep training and taking part in community activities regardless of selection.',
  },
  {
    no: '03',
    title: 'Compete',
    text: 'We field multiple squads across ICPC and CCPC regionals and finals, the ACM-HK Programming Contest, invitationals and open contests. Travel is supported jointly by the Department of Computer Science and the Department of AI & Data Science.',
  },
];




---

<BaseLayout
  title="About"
  description="How the HKU Competitive Programming Community trains, selects and supports its teams."
>
  <PageHeader
    index="01"
    label="About"
    title="A small community with a high bar."
    intro="A student-run community supported by the Department of Computer Science and the Department of AI & Data Science, founded in 1991. We train weekly, place contestants into squads through an annual selection contest, and compete across ICPC and CCPC contests, the ACM-HK Programming Contest, and other regional and open contests."
    meta="Founded 1991 / Record 1990 — 2026"
  />

  <section class="section">
    <div class="container">
      <div class="statement-grid">
        <p class="kicker">Our purpose</p>
        <p class="statement">
          We exist to make hard problems <span class="accent">less intimidating</span> —
          and good teams <span class="accent">more common</span>.
        </p>
      </div>
    </div>
  </section>

  <section class="facts-band" aria-label="Key facts">
    <div class="container">
      <div class="facts">
        {facts.map((fact) => (
          <div class="fact">
            <p class="fact-label mono">{fact.label}</p>
            <p class="fact-value">{fact.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        index="01"
        title="What we do"
        description="Three commitments that shape every season."
      />
      <div class="pillar-grid">
        {pillars.map((pillar) => (
          <article class="pillar-card">
            <p class="pillar-no mono">{pillar.no}</p>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>





  <JoinCta
    eyebrow="Next intake / Each season"
    title="New to competitive programming?"
    text="Start with the community channels, come to an info session and take the selection contest. No application form and no minimum rating."
    linkLabel="How to join"
    linkHref="/join/"
  />
</BaseLayout>
