---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AchievementTable from '../components/AchievementTable.astro';
import JoinCta from '../components/JoinCta.astro';
import { achievementStats, achievements, worldFinals } from '../data/achievements';
import { formatSeason } from '../lib/season';

const years = [...new Set(achievements.map((item) => String(item.year)))].sort(
  (a, b) => Number(b) - Number(a),
);

const seasons = years.map((year) => ({
  year,
  rows: achievements.filter((item) => String(item.year) === year),
}));

const regionalFinals = achievements.filter((item) =>
  /East Continent Final|East Continent League Final|China Final|CCPC Final/.test(item.contest),
);

const regionalMedals = achievements.filter(
  (item) =>
    item.category === 'Regional' &&
    ['Gold', 'Silver', 'Bronze'].includes(item.award),
).length;
---

<BaseLayout
  title="Achievements"
  description="ICPC World Finals appearances, ICPC and CCPC medals, ACM-HK titles and the complete contest record of HKU teams."
>
  <PageHeader
    index="03"
    label="Achievements"
    title="The record."
    intro={`${worldFinals.length} ICPC World Finals appearances, an ICPC World Finals bronze and ${regionalMedals} ICPC regional medals. The record also covers CCPC finals and the ACM-HK Programming Contest, from a 1990–91 local title to the 2026 Xi’an and Chengdu regionals. Some early results may be missing.`}
    meta={`1990 — 2026 / ${achievements.length} entries`}
  />

  <section class="section">
    <div class="container">
      <div class="achievement-stats">
        {achievementStats.map((stat, index) => (
          <div class="achievement-stat">
            <p class="achievement-stat-no mono">{String(index + 1).padStart(2, '0')}</p>
            <p class="achievement-stat-value">{stat.value}</p>
            <p class="achievement-stat-label">{stat.label}</p>
            <p class="achievement-stat-note mono">{stat.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div
        class="year-tabs"
        role="tablist"
        aria-label="Select a season or overview"
        data-achievement-tabs
      >
        <button
          class="year-tab active"
          type="button"
          role="tab"
          id="achievement-tab-overview"
          aria-selected="true"
          aria-controls="achievement-panel-overview"
          tabindex="0"
          data-achievement-tab="overview"
        >
          <span class="year-tab-year">Overview</span>
        </button>
        {seasons.map(({ year, rows }) => (
          <button
            class="year-tab"
            type="button"
            role="tab"
            id={`achievement-tab-${year}`}
            aria-selected="false"
            aria-controls={`achievement-panel-${year}`}
            tabindex="-1"
            data-achievement-tab={year}
          >
            <span class="year-tab-year">{formatSeason(year)}</span>
            <span class="year-tab-count">{rows.length}</span>
          </button>
        ))}
      </div>

      <div
        class="year-panel"
        id="achievement-panel-overview"
        role="tabpanel"
        aria-labelledby="achievement-tab-overview"
        data-achievement-panel="overview"
      >
        <div class="achievement-overview">
          <div class="achievement-overview-head">
            <div>
              <p class="kicker">Overview</p>
              <h2 class="overview-title">ICPC World Finals</h2>
            </div>
            <p class="overview-count mono">{worldFinals.length} appearances</p>
          </div>
          <AchievementTable rows={worldFinals} />

          <div class="achievement-overview-head">
            <div>
              <p class="kicker">Overview</p>
              <h2 class="overview-title">Regional Finals</h2>
            </div>
            <p class="overview-count mono">{regionalFinals.length} results</p>
          </div>
          <AchievementTable rows={regionalFinals} />
        </div>
      </div>

      {seasons.map(({ year, rows }) => (
        <div
          class="year-panel"
          id={`achievement-panel-${year}`}
          role="tabpanel"
          aria-labelledby={`achievement-tab-${year}`}
          data-achievement-panel={year}
          hidden
        >
          <div class="year-head">
            <div>
              <p class="kicker">Season</p>
              <h2 class="year-title">{formatSeason(year)}</h2>
            </div>
            <div class="year-meta">
              <p>{rows.length} {rows.length === 1 ? 'result' : 'results'}</p>
            </div>
          </div>
          <AchievementTable rows={rows} showCategory />
        </div>
      ))}
    </div>
  </section>

  <JoinCta
    eyebrow="The next line"
    title="Add your name to the record."
    text="Every result on this page began with someone deciding to try a contest. The next intake starts in September."
    linkLabel="How to join"
    linkHref="/join/"
  />
</BaseLayout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-achievement-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-achievement-panel]')];

  const activate = (key: string, updateHash = true) => {
    const validKey = panels.some((panel) => panel.dataset.achievementPanel === key)
      ? key
      : 'overview';

    tabs.forEach((tab) => {
      const selected = tab.dataset.achievementTab === validKey;
      tab.classList.toggle('active', selected);
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.achievementPanel !== validKey;
    });

    if (updateHash) {
      history.replaceState(
        null,
        '',
        validKey === 'overview' ? '#overview' : `#year-${validKey}`,
      );
    }
  };

  const hashYear = location.hash.match(/^#year-(\\d{4})/)?.[1];
  activate(hashYear ?? 'overview', false);

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activate(tab.dataset.achievementTab ?? 'overview'));

    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      next.focus();
      activate(next.dataset.achievementTab ?? 'overview');
    });
  });
</script>
