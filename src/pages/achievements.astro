---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Award from '../components/Award.astro';
import JoinCta from '../components/JoinCta.astro';
import {
  achievementStats,
  achievements,
  worldFinals,
} from '../data/achievements';
import { href } from '../lib/url';

const filters = ['All', 'World Finals', 'Regional', 'Local', 'CCPC', 'Other'] as const;
---

<BaseLayout
  title="Achievements"
  description="World Finals appearances, regional medals and the complete contest record of HKU teams since 2000."
>
  <PageHeader
    index="03"
    label="Achievements"
    title="The record."
    intro="Ten World Finals appearances, a World Finals bronze and 58 regional medals since 2000. Every line below started as a practice problem nobody could solve."
    meta={`2000 — 2026 / ${achievements.length} entries`}
  />

  <section class="section">
    <div class="container">
      <div class="achievement-stats">
        {achievementStats.map((stat, index) => (
          <div class="achievement-stat">
            <p class="achievement-stat-no mono">{String(index + 1).padStart(2, '0')}</p>
            <p class="achievement-stat-value">{stat.value}</p>
            <p class="achievement-stat-label">{stat.label}</p>
            <p class="achievement-stat-note mono">{stat.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        index="01"
        title="Contest record"
        description="Filter by contest level. Records are listed newest first."
      />

      <div class="filter-bar" role="group" aria-label="Filter achievements by category">
        {filters.map((filter, index) => (
          <button
            class="filter"
            type="button"
            data-filter={filter}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {filter}
          </button>
        ))}
        <p class="filter-count mono" data-filter-count>{achievements.length} entries</p>
      </div>

      <div class="results results--full" data-achievement-table>
        <div class="result-row result-row--head mono" aria-hidden="true">
          <span>Year</span>
          <span>Contest</span>
          <span>Team</span>
          <span>Rank</span>
          <span>Award</span>
        </div>
        {achievements.map((row) => (
          <div class="result-row" data-category={row.category}>
            <span class="result-year mono">{row.year}</span>
            <span class="result-contest">
              {row.contest}
              <span class="result-category mono">{row.category}</span>
              {row.note && <span class="result-note">{row.note}</span>}
            </span>
            <span class="result-team">{row.team}</span>
            <span class="result-rank mono">{row.rank}</span>
            <span><Award award={row.award} /></span>
          </div>
        ))}
        <p class="results-empty" data-empty hidden>No results in this category.</p>
      </div>

      <p class="source-note mono">
        Source: <a href="https://i.cs.hku.hk/~provinci/achievements.html" rel="noreferrer">HKU Provinci achievements archive ↗</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split-left">
          <p class="kicker">02 / World Finals</p>
          <h2 class="split-title">On the<br />biggest stage.</h2>
          <p class="split-copy">
            The World Finals brings the best university teams in the world into
            one room. HKU has been there ten times, and came home with a bronze
            in 2005.
          </p>
          <a class="btn btn--ghost" href={href('/news/')}>Read the stories <span aria-hidden="true">→</span></a>
        </div>
        <div class="split-right">
          <ol class="finals-list">
            {worldFinals.map((item) => (
              <li>
                <span class="finals-year mono">{item.year}</span>
                <div>
                  <strong>{item.contest}</strong>
                  <span>
                    {item.team} · {item.award === 'Position' ? `${item.rank} place` : item.award}
                    {item.rank !== '—' && item.award !== 'Position' ? ` · ${item.rank}` : ''}
                  </span>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <JoinCta
    eyebrow="The next line"
    title="Add your name to the record."
    text="Every result on this page began with someone deciding to try a contest. The next intake starts in September."
    linkLabel="How to join"
    linkHref="/about/#join"
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('[data-achievement-table] [data-category]');
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  const apply = (filter: string) => {
    let visible = 0;
    rows.forEach((row) => {
      const show = filter === 'All' || row.dataset.category === filter;
      row.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
    if (empty) empty.hidden = visible !== 0;
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      apply(button.dataset.filter ?? 'All');
    });
  });
</script>
