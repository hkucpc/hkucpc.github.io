---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/url';
---

<BaseLayout title="Not found" description="This page does not exist.">
  <section class="not-found">
    <div class="container">
      <p class="kicker">Error 404</p>
      <h1 class="not-found-title">Wrong<br />answer<span class="dot" aria-hidden="true"></span></h1>
      <p class="not-found-copy">
        This page is not in the archive. Check the URL, or head back to
        somewhere that exists.
      </p>
      <div class="hero-actions">
        <a class="btn" href={href('/')}>Back home <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={href('/news/')}>Read the news</a>
      </div>
    </div>
  </section>
</BaseLayout>
