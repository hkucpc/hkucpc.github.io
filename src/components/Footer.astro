---
import { nav, site } from '../data/site';
import { href } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={href('/')} aria-label={`${site.shortName} home`}>
          <img
            class="brand-logo"
            src={href('/hku-crest.webp')}
            width="1024"
            height="1024"
            alt="HKU crest"
          />
          <span class="brand-type">
            <span class="brand-name">Competitive Programming Community</span>
            <span class="brand-sub">The University of Hong Kong</span>
          </span>
        </a>
        <p class="footer-statement">
          A student-run community for people who like their problems hard
          and their code correct.
        </p>
      </div>

      <nav class="footer-col" aria-label="Footer">
        <p class="footer-heading mono">Index</p>
        <ul class="footer-links">
          <li><a href={href('/')}>Home</a></li>
          {nav.map((item) => (
            <li><a href={href(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-heading mono">Contact</p>
        <ul class="footer-links">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a href={`mailto:${site.googleGroup}`}>Google Group ↗</a>
          </li>
          <li><a href={site.discord} rel="noreferrer">Discord ↗</a></li>
          <li><a href={site.github} rel="noreferrer">GitHub ↗</a></li>
          <li><a href={site.linkedin} rel="noreferrer">LinkedIn ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="mono">© {year} {site.shortName}</span>
      <span class="footer-demo">Built by the community</span>
      <a class="mono" href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>
